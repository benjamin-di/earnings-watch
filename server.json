{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.benjamin-di/earnings-watch",
  "description": "Verified issuer earnings calendars and results documents",
  "repository": {
    "url": "https://github.com/benjamin-di/earnings-watch",
    "source": "github"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "earnings-watch",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--stdio"
        }
      ]
    }
  ]
}
